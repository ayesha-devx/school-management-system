# Server configuration
PORT=5000

# PostgreSQL connection string for Prisma ORM (Transaction Mode Pooler)
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:6543/DATABASE_NAME?pgbouncer=true"

# Direct connection string for Prisma migrations (Session Mode or Direct Port 5432)
DIRECT_URL="postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME?schema=public"

# Frontend origin URL for CORS configuration
FRONTEND_URL="http://localhost:5173"
